// Lược đồ dữ liệu 28 bảng khớp 100% với Báo cáo CSDL v1.2 (Mục 3.1 - 3.28)
// Quy ước: tên bảng/field tiếng Anh (code), chú thích tiếng Việt khớp với báo cáo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Các kiểu ENUM ─────────

enum AccountStatus {
  ACTIVE
  LOCKED
}

enum AuthType {
  LOCAL
  GOOGLE
}

enum ElectionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum VoteChoice {
  AGREE
  DISAGREE
  ABSTAIN
}

enum RoleType {
  CLAN_HEAD // Trưởng họ
  BRANCH_HEAD // Trưởng chi
  TECH_SUPPORT // Kỹ thuật viên
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MemberStatus {
  ALIVE
  DECEASED
  REMOVED
}

enum CalendarType {
  SOLAR
  LUNAR
}

enum RelationType {
  PARENT_CHILD
  SPOUSE
}

enum VisibilityScope {
  PRIVATE
  BRANCH
  CLAN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum JoinRequestKind {
  BY_ACCOUNT_CODE
  BY_CLAN_CODE
}

enum ProfileRequestType {
  ADD_CHILD
  ADD_SPOUSE
  MARK_DECEASED
  EDIT_PROFILE
  ADD_RELATIVE
  REMOVE_PROFILE
}

enum ContentStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum FundScope {
  CLAN
  BRANCH
}

enum TransactionType {
  INCOME
  EXPENSE
}

// ───────── NHÓM 1: TÀI KHOẢN, DÒNG HỌ VÀ PHẢ HỆ (8 BẢNG) ─────────

/// 3.1 Bảng dong_ho
model Clan {
  id        String   @id @default(uuid())
  clanCode  String   @unique
  name      String
  createdAt DateTime @default(now())

  branches            Branch[]
  members             MemberProfile[]
  roles               RoleAssignment[]
  events              Event[]
  funds               Fund[]
  posts               Post[]
  accountProfileLinks AccountProfileLink[]
  electionSessions    ElectionSession[]
  electionVotes       ElectionVote[]
}

/// 3.2 Bảng chi
model Branch {
  id     String @id @default(uuid())
  clanId String
  name   String

  clan          Clan             @relation(fields: [clanId], references: [id])
  members       MemberProfile[]
  roles         RoleAssignment[]
  events        Event[]
  funds         Fund[]
  posts         Post[]
  electionVotes ElectionVote[]

  @@unique([clanId, name])
}

/// 3.3 Bảng ho_so_thanh_vien
model MemberProfile {
  id            String        @id @default(uuid())
  clanId        String
  branchId      String?
  accountId     String?       @unique
  fullName      String
  gender        Gender
  bio           String?
  birthDate     DateTime?     @db.Date
  deathDate     DateTime?     @db.Date
  deathCalendar CalendarType?
  status        MemberStatus  @default(ALIVE)
  generation    Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clan                 Clan                @relation(fields: [clanId], references: [id])
  branch               Branch?             @relation(fields: [branchId], references: [id])
  account              Account?            @relation(fields: [accountId], references: [id])
  privacy              PrivacySetting?
  relationsFrom        Relationship[]      @relation("RelFrom")
  relationsTo          Relationship[]      @relation("RelTo")
  accountProfileLink   AccountProfileLink?
  selectedForElections ElectionSession[]   @relation("SelectedCandidate")
  candidateVotes       ElectionVote[]      @relation("CandidateProfile")

  @@index([clanId, fullName])
  @@index([branchId])
}

/// 3.4 Bảng tai_khoan
model Account {
  id           String        @id @default(uuid())
  accountCode  String        @unique
  phone        String        @unique
  email        String?       @unique
  passwordHash String?
  authType     AuthType      @default(LOCAL)
  googleSub    String?       @unique
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())

  totpCredential TotpCredential?

  profile               MemberProfile?
  accountProfileLinks   AccountProfileLink[]
  roles                 RoleAssignment[]
  joinRequests          JoinRequest[]
  invitationsIn         Invitation[]           @relation("InvitationTarget")
  invitationsBy         Invitation[]           @relation("InvitationSender")
  notifications         Notification[]
  posts                 Post[]
  comments              Comment[]
  reactions             Reaction[]
  passwordResetRequests PasswordResetRequest[]
  requestMessages       RequestMessage[]
  confirmedElections    ElectionSession[]      @relation("ConfirmedElection")
  voterVotes            ElectionVote[]         @relation("VoterAccount")
}

/// Bảo mật xác thực TOTP (Google Authenticator) - Bảng bảo mật riêng biệt
model TotpCredential {
  id              String   @id @default(uuid())
  accountId       String   @unique
  secretEncrypted String // Khóa bí mật đã mã hóa ở tầng ứng dụng (AES-256)
  verified        Boolean  @default(false) // Trạng thái đã quét và xác nhận mã lần đầu
  lastTimeStep    Int? // Time-step cuối cùng đã chấp nhận (chống replay attack)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/// 3.5 Bảng tai_khoan_ho_so
model AccountProfileLink {
  id        String   @id @default(uuid())
  accountId String
  clanId    String
  profileId String   @unique
  linkedAt  DateTime @default(now())

  account Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  clan    Clan          @relation(fields: [clanId], references: [id], onDelete: Restrict)
  profile MemberProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([accountId, clanId])
  @@index([clanId])
}

/// 3.6 Bảng vai_tro_phan_quyen
model RoleAssignment {
  id        String    @id @default(uuid())
  accountId String
  type      RoleType
  clanId    String
  branchId  String?
  validFrom DateTime  @default(now())
  validTo   DateTime?

  account Account @relation(fields: [accountId], references: [id])
  clan    Clan    @relation(fields: [clanId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])

  @@index([accountId, validTo])
  @@index([branchId, type, validTo])
}

/// 3.7 Bảng quan_he_pha_he
model Relationship {
  id        String       @id @default(uuid())
  type      RelationType
  fromId    String
  toId      String
  startDate DateTime?    @db.Date
  active    Boolean      @default(true)

  from MemberProfile @relation("RelFrom", fields: [fromId], references: [id])
  to   MemberProfile @relation("RelTo", fields: [toId], references: [id])

  @@unique([type, fromId, toId])
  @@index([fromId])
  @@index([toId])
}

/// 3.8 Bảng cau_hinh_rieng_tu
model PrivacySetting {
  id           String          @id @default(uuid())
  profileId    String          @unique
  phoneScope   VisibilityScope @default(BRANCH)
  addressScope VisibilityScope @default(BRANCH)
  updatedAt    DateTime        @updatedAt

  profile MemberProfile @relation(fields: [profileId], references: [id])
}

// ───────── NHÓM 2: GIA NHẬP, PHÊ DUYỆT VÀ KIỂM TOÁN (6 BẢNG) ─────────

/// 3.9 Bảng yeu_cau_gia_nhap
model JoinRequest {
  id               String          @id @default(uuid())
  requesterId      String
  kind             JoinRequestKind
  referenceCode    String
  declaredRelation String?
  targetProfileId  String?
  status           RequestStatus   @default(PENDING)
  createdAt        DateTime        @default(now())

  requester Account           @relation(fields: [requesterId], references: [id])
  decision  ApprovalDecision?
}

/// 3.10 Bảng loi_moi_gia_nhap
model Invitation {
  id              String        @id @default(uuid())
  senderId        String
  targetId        String
  proposedRole    String?
  targetProfileId String?
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())

  sender Account @relation("InvitationSender", fields: [senderId], references: [id])
  target Account @relation("InvitationTarget", fields: [targetId], references: [id])
}

/// 3.11 Bảng yeu_cau_cap_nhat_pha_he
model ProfileUpdateRequest {
  id          String             @id @default(uuid())
  clanId      String
  branchId    String?
  requesterId String
  type        ProfileRequestType
  subjectId   String?
  before      Json?
  proposed    Json
  reason      String?
  status      RequestStatus      @default(PENDING)
  createdAt   DateTime           @default(now())

  decision ApprovalDecision?
  messages RequestMessage[]

  @@index([branchId, status])
}

/// 3.12 Bảng trao_doi_yeu_cau
model RequestMessage {
  id        String   @id @default(uuid())
  requestId String
  accountId String
  content   String
  createdAt DateTime @default(now())

  request ProfileUpdateRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  author  Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

/// 3.13 Bảng quyet_dinh_duyet
model ApprovalDecision {
  id                     String   @id @default(uuid())
  approverId             String
  approved               Boolean
  reason                 String?
  decidedAt              DateTime @default(now())
  joinRequestId          String?  @unique
  profileUpdateRequestId String?  @unique
  contributionRequestId  String?  @unique

  joinRequest          JoinRequest?          @relation(fields: [joinRequestId], references: [id])
  profileUpdateRequest ProfileUpdateRequest? @relation(fields: [profileUpdateRequestId], references: [id])
  contributionRequest  ContributionRequest?  @relation(fields: [contributionRequestId], references: [id])
}

/// 3.14 Bảng nhat_ky_thay_doi
model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  actorId    String?
  reason     String?
  at         DateTime @default(now())

  @@index([entityType, entityId])
  @@index([at])
}

// ───────── NHÓM 3: BẢNG TIN, SỰ KIỆN VÀ THÔNG BÁO (6 BẢNG) ─────────

/// 3.15 Bảng bai_viet
model Post {
  id        String        @id @default(uuid())
  clanId    String
  branchId  String?
  authorId  String
  category  String
  content   String
  pinned    Boolean       @default(false)
  official  Boolean       @default(false)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())

  clan        Clan         @relation(fields: [clanId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id])
  author      Account      @relation(fields: [authorId], references: [id])
  comments    Comment[]
  reactions   Reaction[]
  attachments Attachment[]

  @@index([clanId, branchId, createdAt])
}

/// 3.16 Bảng tep_dinh_kem
model Attachment {
  id                    String   @id @default(uuid())
  fileName              String
  mimeType              String
  sizeBytes             Int
  storageKey            String
  createdAt             DateTime @default(now())
  postId                String?
  contributionRequestId String?
  fundTransactionId     String?

  post                Post?                @relation(fields: [postId], references: [id])
  contributionRequest ContributionRequest? @relation(fields: [contributionRequestId], references: [id])
  fundTransaction     FundTransaction?     @relation(fields: [fundTransactionId], references: [id])
}

/// 3.17 Bảng binh_luan
model Comment {
  id        String        @id @default(uuid())
  postId    String
  authorId  String
  content   String
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())

  post   Post    @relation(fields: [postId], references: [id])
  author Account @relation(fields: [authorId], references: [id])
}

/// 3.18 Bảng cam_xuc
model Reaction {
  id        String   @id @default(uuid())
  postId    String
  accountId String
  kind      String   @default("like")
  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@unique([postId, accountId])
}

/// 3.19 Bảng su_kien
model Event {
  id              String       @id @default(uuid())
  clanId          String
  branchId        String?
  title           String
  description     String?
  location        String?
  calendar        CalendarType
  originalDate    String
  solarDate       DateTime?    @db.Date
  recurringYearly Boolean      @default(false)
  sourceProfileId String?
  cancelled       Boolean      @default(false)

  clan   Clan    @relation(fields: [clanId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([clanId, solarDate])
}

/// 3.20 Bảng thong_bao
model Notification {
  id        String              @id @default(uuid())
  accountId String
  channel   NotificationChannel @default(IN_APP)
  type      String
  content   String
  refType   String?
  refId     String?
  read      Boolean             @default(false)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, read])
  @@index([channel, sentAt])
}

// ───────── NHÓM 4: KẾ NHIỆM VÀ TÀI CHÍNH (8 BẢNG) ─────────

/// 3.21 Bảng phien_chon_truong_ho
model ElectionSession {
  id                  String         @id @default(uuid())
  clanId              String
  status              ElectionStatus @default(OPEN)
  startedAt           DateTime       @default(now())
  endedAt             DateTime?
  selectedCandidateId String?
  confirmedById       String?
  resultNote          String?

  clan              Clan           @relation(fields: [clanId], references: [id], onDelete: Restrict)
  selectedCandidate MemberProfile? @relation("SelectedCandidate", fields: [selectedCandidateId], references: [id], onDelete: Restrict)
  confirmedBy       Account?       @relation("ConfirmedElection", fields: [confirmedById], references: [id], onDelete: Restrict)
  votes             ElectionVote[]

  @@index([clanId, status])
}

/// 3.22 Bảng phieu_bau_truong_ho
model ElectionVote {
  id                 String     @id @default(uuid())
  sessionId          String
  clanId             String
  branchId           String
  voterAccountId     String
  candidateProfileId String?
  choice             VoteChoice
  reason             String?
  createdAt          DateTime   @default(now())

  session   ElectionSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  clan      Clan            @relation(fields: [clanId], references: [id], onDelete: Restrict)
  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  voter     Account         @relation("VoterAccount", fields: [voterAccountId], references: [id], onDelete: Restrict)
  candidate MemberProfile?  @relation("CandidateProfile", fields: [candidateProfileId], references: [id], onDelete: Restrict)

  @@unique([sessionId, branchId])
  @@index([sessionId])
}

/// 3.23 Bảng yeu_cau_khoi_phuc_mat_khau
model PasswordResetRequest {
  id        String    @id @default(uuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, expiresAt])
}

/// 3.24 Bảng quy
model Fund {
  id             String    @id @default(uuid())
  clanId         String
  branchId       String?
  scope          FundScope
  name           String
  openingBalance Decimal   @default(0) @db.Decimal(18, 0)

  clan         Clan              @relation(fields: [clanId], references: [id])
  branch       Branch?           @relation(fields: [branchId], references: [id])
  campaigns    Campaign[]
  transactions FundTransaction[]
}

/// 3.25 Bảng dot_dong_gop
model Campaign {
  id      String    @id @default(uuid())
  fundId  String
  name    String
  purpose String?
  startAt DateTime?
  endAt   DateTime?

  fund     Fund                  @relation(fields: [fundId], references: [id])
  requests ContributionRequest[]
}

/// 3.26 Bảng yeu_cau_dong_gop
model ContributionRequest {
  id            String        @id @default(uuid())
  campaignId    String
  requesterId   String
  amount        Decimal       @db.Decimal(18, 0)
  transferredAt DateTime
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  campaign          Campaign           @relation(fields: [campaignId], references: [id])
  decision          ApprovalDecision?
  transaction       FundTransaction?
  attachments       Attachment[]
  financialVouchers FinancialVoucher[]
}

/// 3.27 Bảng giao_dich_quy
model FundTransaction {
  id                    String          @id @default(uuid())
  fundId                String
  type                  TransactionType
  amount                Decimal         @db.Decimal(18, 0)
  occurredAt            DateTime
  description           String
  contributionRequestId String?         @unique
  reversesId            String?
  createdById           String
  createdAt             DateTime        @default(now())

  fund                Fund                 @relation(fields: [fundId], references: [id])
  contributionRequest ContributionRequest? @relation(fields: [contributionRequestId], references: [id])
  attachments         Attachment[]
  financialVouchers   FinancialVoucher[]

  @@index([fundId, occurredAt])
}

/// 3.28 Bảng chung_tu
model FinancialVoucher {
  id                    String   @id @default(uuid())
  fundTransactionId     String?
  contributionRequestId String?
  fileName              String
  fileType              String
  fileSize              Int?
  storageUrl            String
  createdAt             DateTime @default(now())

  fundTransaction     FundTransaction?     @relation(fields: [fundTransactionId], references: [id], onDelete: Restrict)
  contributionRequest ContributionRequest? @relation(fields: [contributionRequestId], references: [id], onDelete: Restrict)

  @@index([fundTransactionId])
  @@index([contributionRequestId])
}
