# Sao chép file này thành .env.docker rồi chỉnh nếu cần
# cp .env.docker.example .env.docker  (Linux/macOS)
# copy .env.docker.example .env.docker  (Windows cmd)

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=socialmedia_familytree_db
DB_PORT=5432   # Đổi sang 5433/5434 nếu port bị chiếm bởi PG localhost

# API
JWT_ACCESS_SECRET=local-development-secret-change-me
API_PORT=3000

# Web
WEB_PORT=5173

# Mailpit
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
